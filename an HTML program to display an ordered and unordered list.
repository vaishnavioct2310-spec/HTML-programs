<!DOCTYPE html>
<html>
<head>
    <title>Lists in HTML</title>
</head>
<body>

    <h1>HTML Lists</h1>

    <h2>Ordered List</h2>

    <ol>
        <li>HTML</li>
        <li>CSS</li>
        <li>JavaScript</li>
        <li>Python</li>
    </ol>

    <h2>Unordered List</h2>

    <ul>
        <li>Computer Science</li>
        <li>Mathematics</li>
        <li>English</li>
        <li>Physics</li>
    </ul>

</body>
</html>
